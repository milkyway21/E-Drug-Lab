# e-drug lab 环境配置示例
# 复制此文件为 .env 并填入实际值

# ============ 数据库配置 ============
database__url=postgresql://postgres:password@localhost:5432/edrug_lab
database__pool_size=10
database__echo=false

# ============ 薛定谔接口配置 ============
schrodinger__api_key=your-schrodinger-api-key-here
schrodinger__base_url=https://api.schrodinger.com/v1
schrodinger__timeout=300

# ============ DrugClip 接口配置 ============
drugclip__api_key=your-drugclip-api-key-here
drugclip__base_url=https://api.drugclip.com/v1

# ============ TAME-VS 接口配置 ============
tame_vs__api_key=your-tamevs-api-key-here
tame_vs__base_url=https://api.tamevs.org/v1
tame_vs__timeout=600

# ============ DiffDynamic 接口配置 ============
diffdynamic__api_key=your-diffdynamic-api-key-here
diffdynamic__base_url=https://api.diffdynamic.org/v1
diffdynamic__timeout=900

# ============ 本地工具路径配置 ============
tool_paths__autodock_vina=C:\tools\autodock_vina\vina.exe
tool_paths__fpocket=C:\tools\fpocket\fpocket.exe
tool_paths__gromacs=C:\tools\gromacs\bin\gmx.exe
tool_paths__rdkit_data=C:\tools\rdkit\Data

# ============ Celery 任务队列配置 ============
celery__broker_url=redis://localhost:6379/0
celery__result_backend=redis://localhost:6379/1
celery__task_serializer=json
celery__result_serializer=json
celery__timezone=Asia/Shanghai

# ============ SDF 分子库配置 ============
SDF_DIRECTORY=../molecules/sdf

# ============ 应用配置 ============
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=json

# ============ CORS 配置 ============
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
