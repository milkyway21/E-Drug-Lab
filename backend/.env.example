# e-drug lab 环境配置示例
# 复制此文件为 .env 并填入实际值

# ============ 数据库配置（必填） ============
database__url=sqlite:///./edrug_lab_dev.db
database__pool_size=10
database__echo=false

# ============ 薛定谔接口配置（可选） ============
# schrodinger__api_key=your-schrodinger-api-key-here
# schrodinger__base_url=https://api.schrodinger.com/v1
# schrodinger__timeout=300

# ============ DrugCLIP Docker 配置（可选） ============
# drugclip__wsl_distro=eDrugUbuntu
# drugclip__package_path=deliverables/drugclip-package
# drugclip__service_url=http://localhost:8500
# drugclip__image_name=drugclip-api:latest
# drugclip__timeout=600

# ============ TAME-VS 接口配置（可选） ============
# tame_vs__api_key=your-tamevs-api-key-here
# tame_vs__base_url=https://api.tamevs.org/v1
# tame_vs__timeout=600

# ============ DiffDynamic 配置（可选，默认本地 /data/ye/DiffDynamic） ============
# diffdynamic__runtime=local
# diffdynamic__conda_env=diffdynamic
# diffdynamic__root=/data/ye/DiffDynamic
# diffdynamic__sampling_config=configs/sampling.yml
# diffdynamic__protein_root=data/crossdocked_v1.1_rmsd1.0_pocket10
# diffdynamic__default_device=cuda:0
# diffdynamic__outputs_dir=outputs/diffdynamic
# diffdynamic__vina_timeout=20
# diffdynamic__api_key=your-diffdynamic-api-key-here
# diffdynamic__base_url=https://api.diffdynamic.org/v1
# diffdynamic__timeout=900

# ============ DiffGUI 配置（可选） ============
# diffgui__root=/data/ye/diffgui
# diffgui__conda_env=diffgui_new
# diffgui__sample_config=configs/sample/sample.yml
# diffgui__default_device=cuda:0

# ============ GLARE 配置（可选） ============
# glare__root=/data/ye/diffgui
# glare__config_path=glare_selector/glare_config.yaml
# glare__db_path=vav1_molecular_glue_screening.db
# glare__seed_activity_file=data/seed/seed_activity_data.xlsx
# glare__conda_env=diffgui_new

# ============ 本地工具路径配置（可选） ============
# tool_paths__autodock_vina=C:\tools\autodock_vina\vina.exe
# tool_paths__fpocket=C:\tools\fpocket\fpocket.exe
# tool_paths__gromacs=C:\tools\gromacs\bin\gmx.exe
# tool_paths__rdkit_data=C:\tools\rdkit\Data

# ============ Celery 任务队列配置（可选，有默认值） ============
# celery__broker_url=redis://localhost:6379/0
# celery__result_backend=redis://localhost:6379/1
# celery__task_serializer=json
# celery__result_serializer=json
# celery__timezone=Asia/Shanghai

# ============ SDF 分子库配置 ============
SDF_DIRECTORY=../molecules/sdf

# ============ 应用配置 ============
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=json

# ============ CORS 配置 ============
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
