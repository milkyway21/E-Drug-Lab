.claude/
frontend/.claude/
.codegraph/
C*tmpadmet_result.json

# Extensionless license files
!LICENSE
!NOTICE
!**/LICENSE
!**/NOTICE

# Live secrets (examples stay allowed via *.example)
**/.env
**/.env.local
**/.hermes/
**/providers.yaml
!**/.env.example
!**/providers.example.yaml
