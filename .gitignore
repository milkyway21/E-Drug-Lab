# Ignore everything by default
*

# Keep directory traversal
!*/

# Always keep git config files
!.gitignore
!.gitattributes

# Markdown
!*.md
!*.MD

# Common code / config files
!*.py
!*.ipynb
!*.js
!*.jsx
!*.ts
!*.tsx
!*.mjs
!*.cjs
!*.java
!*.kt
!*.go
!*.rs
!*.c
!*.cc
!*.cpp
!*.cxx
!*.h
!*.hpp
!*.cs
!*.php
!*.rb
!*.swift
!*.scala
!*.r
!*.R
!*.jl
!*.sh
!*.bash
!*.zsh
!*.ps1
!*.sql
!*.graphql
!*.proto
!*.toml
!*.yaml
!*.yml
!*.json
!*.xml
!*.ini
!*.cfg
!*.conf
!*.env.example
!Dockerfile
!docker-compose*.yml
!Makefile
!CMakeLists.txt

# Frontend style/assets in code scope
!*.css
!*.scss
!*.sass
!*.less
!*.html
!*.svg

# Explicitly exclude common large/binary artifacts even if nested
*.zip
*.7z
*.rar
*.tar
*.gz
*.bz2
*.xz
*.onnx
*.pt
*.pth
*.h5
*.ckpt
*.bin
*.db
*.sqlite
*.sqlite3
*.pdf
*.mp4
*.mov
*.avi
*.mkv
*.mp3
*.wav
*.flac
*.png
*.jpg
*.jpeg
*.webp
*.tif
*.tiff
*.npy
*.npz
*.pkl
*.joblib

# Build/cache/dependency directories (always ignore)
node_modules/
**/node_modules/
.next/
**/.next/
dist/
**/dist/
build/
**/build/
coverage/
**/coverage/
.cache/
**/.cache/
__pycache__/
**/__pycache__/
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.venv/
**/.venv/
venv/
**/venv/
.tox/
**/.tox/
