# Copy to .env — never commit real secrets.
# Prefer: bash scripts/start_agent.sh sync  (CC-Switch → .hermes/.env)
# Dialogue uses Hermes multi-provider chat, not masld-agent chat.

# --- Volcano / 方舟 Coding Plan (from CC-Switch 火山Agentplan) ---
# OpenAI-compatible (Hermes volcengine-plan). MUST use /api/coding/v3 (not /api/v3).
MASLD_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
MASLD_LLM_API_KEY=
MASLD_LLM_MODEL=ark-code-latest
MASLD_LLM_TIMEOUT=90
MASLD_LLM_TEMPERATURE=0.2
OPENAI_API_KEY=
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3

# Anthropic-compatible (Hermes volcano-anthropic / --provider anthropic)
ANTHROPIC_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=ark-code-latest

# HTTP cache directory
MASLD_HTTP_CACHE_DIR=.cache/http

# Optional NCBI email for PubMed E-utilities courtesy
NCBI_EMAIL=

# Competition evaluation mode (disables Hermes self-evolution when true)
MASLD_COMPETITION_EVAL_MODE=true
